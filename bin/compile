#!/bin/bash

indent() {
  sed -u 's/^/       /'
}

echo "-----> Install GhostScript"

BUILD_DIR=$1
CACHE_DIR=$2
VENDOR_DIR="$BUILD_DIR/vendor"
INSTALL_DIR="$VENDOR_DIR/ghostscript"
GS_VERSION="10.04.0"
GS_VERSION_SHORT="10040"
CACHE_FILE="$CACHE_DIR/ghostscript-$GS_VERSION.tar.gz"

if [ ! -f $CACHE_FILE ]; then
  # install imagemagick
  GS_FILE="ghostscript-$GS_VERSION.tar.gz"
  GS_DIR="ghostscript-$GS_VERSION"
  GS_URL="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs$GS_VERSION_SHORT/$GS_FILE"

  echo "-----> Downloading GhostScript from $GS_URL"
  wget $GS_URL -P $BUILD_DIR | indent

  echo "-----> Extracting GhostScript from $BUILD_DIR/$GS_FILE"
  if [ ! -f $BUILD_DIR/$GS_FILE ]; then
    echo "Error: Unable to download GhostScript" | indent
    ls $BUILD_DIR | indent
    exit 1;
  fi
  tar xvf $BUILD_DIR/$GS_FILE | indent

  echo "-----> Building GhostScript"
  cd $GS_DIR
  export CPPFLAGS="-I$INSTALL_DIR/include"
  export LDFLAGS="-L$INSTALL_DIR/lib"
  ./configure --prefix=$INSTALL_DIR
  make && make install
  cd ..
  rm -rf $GS_DIR

  # cache for future deploys
  echo "-----> Caching GhostScript installation"
  cd $VENDOR_DIR
  REL_INSTALL_DIR="ghostscript"
  tar czf $REL_INSTALL_DIR.tar.gz $REL_INSTALL_DIR

  if [ ! -d $CACHE_DIR ]; then
    mkdir -p $CACHE_DIR
  fi

  mv $REL_INSTALL_DIR.tar.gz $CACHE_FILE

else
  # cache exists, extract it
  echo "-----> Extracting GhostScript $CACHE_FILE => $VENDOR_DIR"
  mkdir -p $VENDOR_DIR
  tar xzf $CACHE_FILE -C $VENDOR_DIR
fi

# update PATH and LD_LIBRARY_PATH
echo "-----> Updating environment variables"
PROFILE_PATH="$BUILD_DIR/.profile.d/ghostscript.sh"
ACTUAL_INSTALL_PATH="$HOME/vendor/ghostscript"
mkdir -p $(dirname $PROFILE_PATH)
echo "export PATH=$ACTUAL_INSTALL_PATH/bin:\$PATH" >> $PROFILE_PATH
echo "export MAGICK_CONFIGURE_PATH=$ACTUAL_INSTALL_PATH" >> $PROFILE_PATH
echo "-----> Done updating environment variables. All set for GhostScript."